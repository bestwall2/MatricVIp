<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="6dp"
		android:background="#1D5B79"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/lin_main"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="2dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:background="@drawable/back"
			android:clipToOutline="true">
			<LinearLayout
				android:id="@+id/lin"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/lin_1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_weight="1">
					<ImageView
						android:id="@+id/img2"
						android:layout_width="50dp"
						android:layout_height="50dp"
						android:layout_marginTop="10dp"
						android:background="@android:color/transparent"
						android:src="@drawable/tty"
						android:scaleType="fitCenter"
						android:focusable="false"
						android:clipToOutline="true" />
					<TextView
						android:id="@+id/name2"
						android:focusable="false"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_margin="2dp"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="الجزائر"
						android:textSize="11sp"
						android:textStyle="bold"
						android:textColor="#EEEEEE"
						android:singleLine="true"
						android:lines="1"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/lin_2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_gravity="center_horizontal|center_vertical"
					android:layout_weight="1">
					<LinearLayout
						android:id="@+id/posi"
						android:layout_width="80dp"
						android:layout_height="wrap_content"
						android:padding="6dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:background="@drawable/position">
						<TextView
							android:id="@+id/status"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:background="@android:color/transparent"
							android:gravity="center_horizontal|center_vertical"
							android:text="لم تبدأ"
							android:textSize="10sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF"
							android:singleLine="true"
							android:lines="1"
							android:ems="5" />
					</LinearLayout>
					<TextView
						android:id="@+id/time"
						android:focusable="false"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="00:23:00"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF"
						android:singleLine="true"
						android:lines="1" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/lin_3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_weight="1">
					<ImageView
						android:id="@+id/img1"
						android:layout_width="50dp"
						android:layout_height="50dp"
						android:layout_marginTop="10dp"
						android:background="@android:color/transparent"
						android:src="@drawable/tty"
						android:scaleType="fitCenter"
						android:focusable="false"
						android:clipToOutline="true" />
					<TextView
						android:id="@+id/name1"
						android:focusable="false"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="المغرب"
						android:textSize="11sp"
						android:textStyle="bold"
						android:textColor="#EEEEEE"
						android:singleLine="true"
						android:lines="1"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/lin_color"
				android:layout_width="300dp"
				android:layout_height="1dp"
				android:background="#757575"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical" />
			<LinearLayout
				android:id="@+id/lin_dawri_channel"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/lin_channel"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="2dp"
					android:background="@android:color/transparent"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_weight="1">
					<TextView
						android:id="@+id/channel"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="BEIN SPORT 1"
						android:textSize="11sp"
						android:textStyle="bold"
						android:textColor="#EEEEEE"
						android:singleLine="true"
						android:lines="1" />
					<ImageView
						android:id="@+id/icc_channel"
						android:focusable="false"
						android:layout_width="18dp"
						android:layout_height="18dp"
						android:layout_marginLeft="3dp"
						android:src="@drawable/ic_television_classic"
						android:scaleType="fitCenter"
						android:clipToOutline="true" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear1"
					android:layout_width="1dp"
					android:layout_height="30dp"
					android:background="#757575"
					android:orientation="vertical" />
				<LinearLayout
					android:id="@+id/lin_dawri"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="2dp"
					android:background="@android:color/transparent"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_weight="1">
					<TextView
						android:id="@+id/dawri"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="حفيظ الدراجي"
						android:textSize="11sp"
						android:textStyle="bold"
						android:textColor="#EEEEEE"
						android:singleLine="true"
						android:lines="1" />
					<ImageView
						android:id="@+id/icc_dawri"
						android:focusable="false"
						android:layout_width="19dp"
						android:layout_height="19dp"
						android:layout_marginLeft="3dp"
						android:src="@drawable/trophy"
						android:scaleType="fitCenter"
						android:clipToOutline="true" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
